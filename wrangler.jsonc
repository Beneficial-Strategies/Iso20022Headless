// Cloudflare Worker for the demos (see docs/cloudflare-deploy.md): the built site is served as static assets, and the one
// path /iso20022-xsd/* goes to the Worker first, which passes ISO's XSD schemas through to the page.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iso20022-explorer",
  "main": "tools/cloudflare/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/iso20022-xsd/*"]
  },
  // the built-in address (<name>.<account>.workers.dev) and per-branch preview addresses stay on; said here so that wrangler need not warn about defaults
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
