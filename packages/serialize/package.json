{
  "name": "@beneficial-strategies/iso20022-serialize",
  "version": "0.1.0-alpha.0",
  "description": "Read and write ISO 20022 messages as XML and as ISO JSON, from and to the values of the validate schemas.",
  "license": "MIT",
  "author": "Beneficial Strategies",
  "homepage": "https://github.com/Beneficial-Strategies/Iso20022Headless#readme",
  "bugs": {
    "url": "https://github.com/Beneficial-Strategies/Iso20022Headless/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beneficial-Strategies/Iso20022Headless.git",
    "directory": "packages/serialize"
  },
  "keywords": [
    "iso20022",
    "iso-20022",
    "payments",
    "pain.001",
    "camt",
    "pacs",
    "financial-messaging"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node ../../tools/publish/postbuild.mjs",
    "prepack": "node ../../tools/publish/prepack.mjs"
  },
  "dependencies": {
    "@beneficial-strategies/iso20022-validate": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "fast-xml-parser": "^5.2.0"
  }
}
