{
  "name": "@beneficial-strategies/iso20022-react-ui",
  "version": "0.1.0-alpha.1",
  "description": "React components that render an ISO 20022 form from the validate schemas, with English text and replaceable skins.",
  "license": "MIT",
  "author": "Beneficial Strategies",
  "homepage": "https://github.com/Beneficial-Strategies/Iso20022Headless#readme",
  "bugs": {
    "url": "https://github.com/Beneficial-Strategies/Iso20022Headless/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Beneficial-Strategies/Iso20022Headless.git",
    "directory": "packages/react-ui"
  },
  "keywords": [
    "iso20022",
    "iso-20022",
    "payments",
    "pain.001",
    "camt",
    "pacs",
    "financial-messaging"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./theme.css": "./dist/theme.css"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && node ../../tools/publish/postbuild.mjs",
    "prepack": "node ../../tools/publish/prepack.mjs"
  },
  "dependencies": {
    "@beneficial-strategies/iso20022-validate": "workspace:*",
    "@beneficial-strategies/iso20022-react": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "zod": ">=4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "zod": "^4.0.0",
    "vitest": "^3.2.0",
    "jsdom": "^26.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@testing-library/dom": "^10.4.0"
  }
}
