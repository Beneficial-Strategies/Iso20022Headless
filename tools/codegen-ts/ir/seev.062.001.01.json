    "SecurityIdentification19": {
      "name": "SecurityIdentification19",
      "isoId": "_ho6XQYlXEeWPSZi0kAOXhg",
      "kind": "component",
      "fields": [
        {
          "name": "ISIN",
          "isoId": "_iDjE24lXEeWPSZi0kAOXhg",
          "xmlTag": "ISIN",
          "type": "ISINOct2015Identifier",
          "kind": "text",
          "min": 0,
          "max": 1
        },
        {
          "name": "OtherIdentification",
          "isoId": "_iDjE3YlXEeWPSZi0kAOXhg",
          "xmlTag": "OthrId",
          "type": "OtherIdentification1",
          "kind": "component",
          "min": 0,
          "max": null
        },
        {
          "name": "Description",
          "isoId": "_iDjE34lXEeWPSZi0kAOXhg",
          "xmlTag": "Desc",
          "type": "Max140Text",
          "kind": "text",
          "min": 0,
          "max": 1
        }
      ],
      "rules": [
        {
          "name": "DescriptionPresenceRule",
          "isoId": "_iDjE0YlXEeWPSZi0kAOXhg",
          "text": "If Description is not present then either ISIN or at least one occurrence of OtherIdentification must be present.",
          "expression": {
            "mustBe": {
              "connector": "OR",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/ISIN"
                },
                {
                  "op": "Presence",
                  "path": "/OtherIdentification[*]"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/Description"
                }
              ]
            }
          }
        },
        {
          "name": "OtherIdentificationPresenceRule",
          "isoId": "_iDjE04lXEeWPSZi0kAOXhg",
          "text": "If OtherIdentification is not present then either ISIN or Description must be present.",
          "expression": {
            "mustBe": {
              "connector": "OR",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/ISIN"
                },
                {
                  "op": "Presence",
                  "path": "/Description"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/OtherIdentification[*]"
                }
              ]
            }
          }
        },
        {
          "name": "ISINPresenceRule",
          "isoId": "_iDjE1YlXEeWPSZi0kAOXhg",
          "text": "If ISIN is not present then either Description or at least one occurrence of OtherIdentification must be present.",
          "expression": {
            "mustBe": {
              "connector": "OR",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/OtherIdentification[*]"
                },
                {
                  "op": "Presence",
                  "path": "/Description"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/ISIN"
                }
              ]
            }
          }
        },
        {
          "name": "DescriptionUsageRule",
          "isoId": "_iDjE14lXEeWPSZi0kAOXhg",
          "text": "Description must be used alone as the last resort."
        },
        {
          "name": "ISINGuideline",
          "isoId": "_iDjE2YlXEeWPSZi0kAOXhg",
          "text": "When an ISIN code exists, it is strongly recommended that the ISIN be used."
        }
      ]
    },
