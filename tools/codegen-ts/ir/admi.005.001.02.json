        {
          "name": "ProcessingDate",
          "isoId": "_6V0PbTEyEe6g-ffJsqGiSA",
          "xmlTag": "PrcgDt",
          "type": "DateAndDateTimeSearch4Choice",
          "kind": "choice",
          "min": 0,
          "max": 1
        }
      ],
      "rules": [
        {
          "name": "CounterpartyIdentification1Rule",
          "isoId": "_6V0PYTEyEe6g-ffJsqGiSA",
          "text": "If at least one occurrence of CounterpartyType is present and is equal to Multilateral (MULT), then no occurrence of CounterpartyIdentification is allowed.|If CounterpartyType is not present, then any occurrence of CounterpartyIdentification is optional.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/CounterpartyIdentification[1]"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/CounterpartyType"
                },
                {
                  "op": "EqualToValue",
                  "path": "/CounterpartyType",
                  "value": "Multilateral"
                }
              ]
            }
          }
        },
        {
          "name": "CounterpartyIdentification2Rule",
          "isoId": "_6V0PYzEyEe6g-ffJsqGiSA",
          "text": "If at least one occurrence of CounterpartyType is present and is equal to Bilateral (BILA), then at least one occurrence of CounterpartyIdentification must be present.|If CounterpartyType is not present, then any occurrence of CounterpartyIdentification is optional.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/CounterpartyIdentification[1]"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/CounterpartyType"
                },
                {
                  "op": "EqualToValue",
                  "path": "/CounterpartyType",
                  "value": "Bilateral"
                }
              ]
            }
          }
        }
      ]
    },
