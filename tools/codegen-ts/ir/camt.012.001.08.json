    "LimitIdentification8": {
      "name": "LimitIdentification8",
      "isoId": "_0WRu0TEyEe6g-ffJsqGiSA",
      "kind": "component",
      "fields": [
        {
          "name": "SystemIdentification",
          "isoId": "_0YhKhTEyEe6g-ffJsqGiSA",
          "xmlTag": "SysId",
          "type": "SystemIdentification2Choice",
          "kind": "choice",
          "min": 0,
          "max": 1
        },
        {
          "name": "BilateralLimitCounterpartyIdentification",
          "isoId": "_0YhKhzEyEe6g-ffJsqGiSA",
          "xmlTag": "BilLmtCtrPtyId",
          "type": "BranchAndFinancialInstitutionIdentification8",
          "kind": "component",
          "min": 0,
          "max": 1
        },
        {
          "name": "Type",
          "isoId": "_0YhKiTEyEe6g-ffJsqGiSA",
          "xmlTag": "Tp",
          "type": "LimitType1Choice",
          "kind": "choice",
          "min": 1,
          "max": 1
        },
        {
          "name": "AccountOwner",
          "isoId": "_0YhKizEyEe6g-ffJsqGiSA",
          "xmlTag": "AcctOwnr",
          "type": "BranchAndFinancialInstitutionIdentification8",
          "kind": "component",
          "min": 0,
          "max": 1
        },
        {
          "name": "AccountIdentification",
          "isoId": "_0YhKjTEyEe6g-ffJsqGiSA",
          "xmlTag": "AcctId",
          "type": "AccountIdentification4Choice",
          "kind": "choice",
          "min": 0,
          "max": 1
        }
      ],
      "rules": [
        {
          "name": "BilateralLimitCounterparty1Rule",
          "isoId": "_0YhKgTEyEe6g-ffJsqGiSA",
          "text": "If Type is MULT, then BilateralLimitCounterpartyIdentification is not allowed.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/BilateralLimitCounterpartyIdentification"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "EqualToValue",
                  "path": "/Type/Code",
                  "value": "Multilateral"
                }
              ]
            }
          }
        },
        {
          "name": "BilateralLimitCounterparty2Rule",
          "isoId": "_0YhKgzEyEe6g-ffJsqGiSA",
          "text": "If Type is BILI or NELI or INBI, then BilateralLimitCounterpartyIdentification must be present.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/BilateralLimitCounterpartyIdentification"
                }
              ]
            },
            "onCondition": {
              "connector": "OR",
              "rules": [
                {
                  "op": "EqualToValue",
                  "path": "/Type/Code",
                  "value": "Bilateral"
                },
                {
                  "op": "EqualToValue",
                  "path": "/Type/Code",
                  "value": "NetBilateral"
                },
                {
                  "op": "EqualToValue",
                  "path": "/Type/Code",
                  "value": "IndirectBilateral"
                }
              ]
            }
          }
        }
      ]
    },
