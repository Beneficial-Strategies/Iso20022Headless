      "rules": [
        {
          "name": "SafekeepingPlaceRule",
          "isoId": "_6Nts4Y-9Ee-COKgew96POA",
          "text": "The SafekeepingPlace is only to be used by global custodians that allow their clients to specify where the securities are to be held, for example, in an ICSD account versus an account at the local CSD."
        },
        {
          "name": "SafekeepingAccountOrBlockChainAddress1Rule",
          "isoId": "_6Nts44-9Ee-COKgew96POA",
          "text": "Either SafekeepingAccount or BlockChainAddressOrWallet must be present but not both.",
          "expression": {
            "mustBe": {
              "connector": "OR",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/SafekeepingAccount"
                },
                {
                  "op": "Presence",
                  "path": "/BlockChainAddressOrWallet"
                }
              ]
            }
          }
        },
        {
          "name": "SafekeepingAccountOrBlockChainAddress2Rule",
          "isoId": "_6Nts5Y-9Ee-COKgew96POA",
          "text": "If BlockChainAddressOrWallet is present then SafekeepingAccount must be absent.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/SafekeepingAccount"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/BlockChainAddressOrWallet"
                }
              ]
            }
          }
        },
        {
          "name": "SafekeepingAccountOrBlockChainAddress3Rule",
          "isoId": "_6Nts54-9Ee-COKgew96POA",
          "text": "If SafekeepingAccount is present, then BlockChainAddressOrWallet must be absent.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/BlockChainAddressOrWallet"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/SafekeepingAccount"
                }
              ]
            }
          }
        }
      ]
