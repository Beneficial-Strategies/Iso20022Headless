      "rules": [
        {
          "name": "SafekeepingAccountOrBlockChainAddress1Rule",
          "isoId": "_3ailR6ouEfCG2_q2WT-90w",
          "text": "If SafekeepingAccount is present, BlockChainAddressOrWallet must be absent.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/BlockChainAddressOrWallet"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/SafekeepingAccount"
                }
              ]
            }
          }
        },
        {
          "name": "SafekeepingAccountOrBlockChainAddress2Rule",
          "isoId": "_3ailSaouEfCG2_q2WT-90w",
          "text": "If BlockChainAddressOrWallet is present, SafekeepingAccount must be absent.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/SafekeepingAccount"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/BlockChainAddressOrWallet"
                }
              ]
            }
          }
        },
        {
          "name": "SafekeepingAccountOrBlockChainAddress3Rule",
          "isoId": "_3ailS6ouEfCG2_q2WT-90w",
          "text": "Either SafekeepingAccount or BlockChainAddressOrWallet must be present but not both.",
          "expression": {
            "mustBe": {
              "connector": "OR",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/SafekeepingAccount"
                },
                {
                  "op": "Presence",
                  "path": "/BlockChainAddressOrWallet"
                }
              ]
            }
          }
        }
      ]
    }
