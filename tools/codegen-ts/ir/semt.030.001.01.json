{
  "message": {
    "identifier": "semt.030.001.01",
    "name": "SecuritiesSettlementConditionsModificationRequestQueryV01",
    "namespace": "urn:iso:std:iso:20022:tech:xsd:semt.030.001.01",
    "bodyTag": "SctiesSttlmCondsModReqQry",
    "out": "semt030",
    "isoId": "_iPj3reShEe-qVZLXW4RRBw",
    "definition": "The SecuritiesSettlementConditionsModificationRequestQuery message is sent from an account owner/requestor to a settlement infrastructure to query for the status of settlement or intra-position movement modification instruction(s) based on a set of search criteria or business attributes.|The message may also be used to: |- re-send a message sent by the account owner to the account servicer (the sub-function of the message is \"Duplicate\") |- provide a third party with a copy of a message being sent by the account owner for information (the sub-function of the message is \"Copy\") |- re-send to a third party a copy of a message being sent by the account owner for information (the sub-function of the message is \"Copy Duplicate\").",
    "blocks": [
      {
        "name": "QueryDefinition",
