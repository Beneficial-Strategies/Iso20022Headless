    "SecurityIdentification20": {
      "name": "SecurityIdentification20",
      "isoId": "_cdRCO5KQEeWHWpTQn1FFVg",
      "kind": "component",
      "fields": [
        {
          "name": "ISIN",
          "isoId": "_cdRCR5KQEeWHWpTQn1FFVg",
          "xmlTag": "ISIN",
          "type": "ISINOct2015Identifier",
          "kind": "text",
          "min": 0,
          "max": 1
        },
        {
          "name": "OtherIdentification",
          "isoId": "_cdRCSZKQEeWHWpTQn1FFVg",
          "xmlTag": "OthrId",
          "type": "OtherIdentification2",
          "kind": "component",
          "min": 0,
          "max": null
        },
        {
          "name": "Description",
          "isoId": "_cdRCS5KQEeWHWpTQn1FFVg",
          "xmlTag": "Desc",
          "type": "RestrictedFINXMax140Text",
          "kind": "text",
          "min": 0,
          "max": 1
        }
      ],
      "rules": [
        {
          "name": "DescriptionPresenceRule",
          "isoId": "_cdRCPZKQEeWHWpTQn1FFVg",
          "text": "If Description is not present then either ISIN or at least one occurrence of OtherIdentification must be present.",
          "expression": {
            "mustBe": {
              "connector": "OR",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/ISIN"
                },
                {
                  "op": "Presence",
                  "path": "/OtherIdentification[*]"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/Description"
                }
              ]
            }
          }
        },
        {
          "name": "OtherIdentificationPresenceRule",
          "isoId": "_cdRCP5KQEeWHWpTQn1FFVg",
          "text": "If OtherIdentification is not present then either ISIN or Description must be present.",
          "expression": {
            "mustBe": {
              "connector": "OR",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/ISIN"
                },
                {
                  "op": "Presence",
                  "path": "/Description"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/OtherIdentification[*]"
                }
              ]
            }
          }
        },
        {
          "name": "ISINPresenceRule",
          "isoId": "_cdRCQZKQEeWHWpTQn1FFVg",
          "text": "If ISIN is not present then either Description or at least one occurrence of OtherIdentification must be present.",
          "expression": {
            "mustBe": {
              "connector": "OR",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/OtherIdentification[*]"
                },
                {
                  "op": "Presence",
                  "path": "/Description"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/ISIN"
                }
              ]
            }
          }
        },
        {
          "name": "DescriptionUsageRule",
          "isoId": "_cdRCQ5KQEeWHWpTQn1FFVg",
          "text": "Description must be used alone as the last resort."
        },
        {
          "name": "ISINGuideline",
          "isoId": "_cdRCRZKQEeWHWpTQn1FFVg",
          "text": "When a ISIN code exist. It is strongly recommended that the ISIN be used."
        }
      ]
    },
