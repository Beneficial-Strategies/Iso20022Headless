      "kind": "component",
      "fields": [
        {
          "name": "SafekeepingAccount",
          "isoId": "_nF16LZt3Ee-wQIOX0djF2w",
          "xmlTag": "SfkpgAcct",
          "type": "RestrictedFINXMax35Text",
          "kind": "text",
          "min": 0,
          "max": 1
        },
        {
          "name": "BlockChainAddressOrWallet",
          "isoId": "_nF16NZt3Ee-wQIOX0djF2w",
          "xmlTag": "BlckChainAdrOrWllt",
          "type": "RestrictedFINXMax140Text",
          "kind": "text",
          "min": 0,
          "max": 1
        },
        {
          "name": "AccountOwner",
          "isoId": "_nF16N5t3Ee-wQIOX0djF2w",
          "xmlTag": "AcctOwnr",
          "type": "PartyIdentification136Choice",
          "kind": "choice",
          "min": 0,
          "max": 1
        },
        {
          "name": "SafekeepingPlace",
          "isoId": "_nF16P5t3Ee-wQIOX0djF2w",
          "xmlTag": "SfkpgPlc",
          "type": "SafekeepingPlaceFormat54Choice",
          "kind": "choice",
          "min": 0,
          "max": 1
        },
        {
          "name": "ConfirmedBalance",
          "isoId": "_nF16R5t3Ee-wQIOX0djF2w",
          "xmlTag": "ConfdBal",
          "type": "BalanceFormat14Choice",
          "kind": "choice",
          "min": 1,
          "max": 1
        }
      ],
      "rules": [
        {
          "name": "SafekeepingPlaceRule",
          "isoId": "_nF16JZt3Ee-wQIOX0djF2w",
          "text": "The SafekeepingPlace is only to be used by global custodians that allow their clients to specify where the securities are to be held, for example, in an ICSD account versus an account at the local CSD."
        },
        {
          "name": "SafekeepingAccountOrBlockChainAddress1Rule",
          "isoId": "_nF16J5t3Ee-wQIOX0djF2w",
          "text": "Either SafekeepingAccount or BlockChainAddressOrWallet must be present but not both.",
          "expression": {
            "mustBe": {
              "connector": "OR",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/SafekeepingAccount"
                },
                {
                  "op": "Presence",
                  "path": "/BlockChainAddressOrWallet"
                }
              ]
            }
          }
        },
        {
          "name": "SafekeepingAccountOrBlockChainAddress2Rule",
          "isoId": "_nF16KZt3Ee-wQIOX0djF2w",
          "text": "If BlockChainAddressOrWallet is present then SafekeepingAccount must be absent.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/SafekeepingAccount"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/BlockChainAddressOrWallet"
                }
              ]
            }
          }
        },
        {
          "name": "SafekeepingAccountOrBlockChainAddress3Rule",
          "isoId": "_nF16K5t3Ee-wQIOX0djF2w",
          "text": "If SafekeepingAccount is present, then BlockChainAddressOrWallet must be absent.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Absence",
                  "path": "/BlockChainAddressOrWallet"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/SafekeepingAccount"
                }
              ]
            }
          }
        }
      ]
    },
