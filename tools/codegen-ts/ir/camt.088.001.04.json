          "name": "CounterpartySettlementInstructionRule",
          "isoId": "559771fb-1509-4aeb-bbf6-f5e0dccdf967",
          "text": "The CounterpartySettlementInstructions must not be present when the obligation direction value is DBIT."
        },
        {
          "name": "CounterpartyIdentificationRule",
          "isoId": "fdb21b7e-93e9-4153-9df6-d49af201ea1a",
          "text": "NetServiceCounterpartyIdentification must be present at this level in all obligations if one or more counterparties are involved in the calculation of the net report, i.e.NetServiceCounterpartyIdentification is not used in NetReport level."
        },
        {
          "name": "SplitIndicatorRule",
          "isoId": "_oat98H2iEfCKoOYI0vp4Dw",
          "text": "If SplitIndicator is true, then TotalNumberOfSplits and SplitObligationData must be present.",
          "expression": {
            "mustBe": {
              "connector": "AND",
              "rules": [
                {
                  "op": "Presence",
                  "path": "/TotalNumberOfSplits"
                },
                {
                  "op": "Presence",
                  "path": "/SplitObligationData[*]"
                }
              ]
            },
            "onCondition": {
              "connector": "AND",
              "rules": [
                {
                  "op": "EqualToValue",
                  "path": "/SplitIndicator",
                  "value": "true"
                }
              ]
            }
          }
        }
      ]
    },
