# Used by Cloudflare (static assets) for the demo served at the root of its host.
# Built files are named after their content, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
# The text packs (proof of concept): the same file names after a redeploy, so a short cache; any site may read them
/text/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
