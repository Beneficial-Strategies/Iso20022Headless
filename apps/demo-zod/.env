# The text hosts the Explorer takes its languages from (apps/demo-shared/src/textHost.ts). English is all the page carries; without a host there is no other language.
# A developer can override this in .env.local; a deployment can set the same variables.
VITE_TEXT_HOST=https://iso-20022-text-{lang}.beneficialstrategies.com
VITE_TEXT_LANGS=en,en-US,fr,de,es,pt
